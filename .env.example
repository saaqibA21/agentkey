# ---- Runtime -------------------------------------------------------------
# development | test | production. Production refuses to boot with default secrets
# and refuses to fall back to mock channel adapters.
ENV=development
PUBLIC_BASE_URL=http://localhost:8000
PLATFORM_NAME=AIgent
# Where the Next.js dashboard is served (used in links the API hands back)
DASHBOARD_URL=http://localhost:3000

# ---- Storage -------------------------------------------------------------
# Local dev needs nothing installed: SQLite file + in-process Redis emulation.
# Production: Postgres (Render gives postgres://..., it is rewritten to asyncpg) and real Redis.
DATABASE_URL=sqlite+aiosqlite:///./agentidentity.db
REDIS_URL=memory://
AUTO_CREATE_TABLES=true

# ---- Secrets (generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))")
ADMIN_SECRET=change-me-admin
SIGNING_SECRET=change-me-signing
INGEST_SECRET=change-me-ingest
# Shared with the dashboard only (web/.env: AIGENT_DASHBOARD_SECRET)
DASHBOARD_SECRET=change-me-dashboard

# ---- Mail ----------------------------------------------------------------
# Domain whose MX points at Cloudflare Email Routing (catch-all -> Worker).
MAIL_DOMAIN=agents.example.com
# Comma-separated domains shared between tenants; the AI disclosure footer is forced on these.
SHARED_DOMAINS=agents.example.com
# console (dev log only) | smtp (AWS SES SMTP or any relay) | resend
MAIL_PROVIDER=console
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESEND_API_KEY=

# ---- WhatsApp (Meta Cloud API) -------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- SMS (MSG91, TRAI DLT) -----------------------------------------------
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
DLT_ENTITY_ID=

# ---- Attachments ---------------------------------------------------------
# local (dev) | s3 (AWS S3, or Cloudflare R2 with S3_ENDPOINT_URL). Credentials: standard AWS_* variables.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_ENDPOINT_URL=

# ---- Custom domains ------------------------------------------------------
# mock (dev) | ses. With ses, AWS credentials need ses:CreateEmailIdentity/GetEmailIdentity/DeleteEmailIdentity.
DOMAIN_PROVIDER=mock
AWS_REGION=us-east-1
CUSTOM_DOMAIN_MX_HOST=inbound-smtp.us-east-1.amazonaws.com
SES_INBOUND_TOPIC_ARN=
# Local demos only: pretend every DNS record is present
DOMAIN_SKIP_DNS_CHECKS=false

# ---- Free plan defaults for self-serve signups ---------------------------
FREE_MAX_INBOXES=5
FREE_INBOUND_DAILY_LIMIT=500
FREE_DAILY_SEND_LIMIT=100

# ---- Limits --------------------------------------------------------------
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=10
WEBHOOK_MAX_ATTEMPTS=8
HITL_TOKEN_TTL_SECONDS=86400

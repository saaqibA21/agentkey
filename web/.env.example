# Generate with: npx auth secret
AUTH_SECRET=

# OAuth apps. Callback URLs: <site>/api/auth/callback/google and <site>/api/auth/callback/github
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The AIgent API (Render) and the secret it shares with this app (API env: DASHBOARD_SECRET)
AIGENT_API_URL=http://localhost:8000
AIGENT_DASHBOARD_SECRET=change-me-dashboard
# Shown in docs and snippets
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local development only: sign in with any email, no OAuth app needed. Ignored in production builds.
AIGENT_DEV_LOGIN=true
